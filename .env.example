# Образец окружения. Реальные значения — в .env, он в .gitignore.
# Доступы лежат в dostupi.txt и в репозиторий не попадают никогда.

# --- окружение ---
ENV=dev
LOG_LEVEL=INFO
# console локально, json на сервере
LOG_FORMAT=console

# --- обязательные, без них старт падает ---
BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://china_bot:пароль@host.docker.internal:5432/china_bot
REDIS_URL=redis://host.docker.internal:6379/5

# --- redis ---
# Redis общий с чужими проектами, префикс обязателен
REDIS_PREFIX=china:

# Куда платёжка возвращает человека после оплаты
BOT_LINK=https://t.me/ChineseToneBot

# --- api ---
API_HOST=0.0.0.0
API_PORT=8080

# --- выбор провайдеров: смена провайдера это настройка, а не правка кода ---
LLM_PROVIDER=openrouter
STT_PROVIDER=openai_whisper
TTS_PROVIDER=fish
PRONUNCIATION_PROVIDER=speechsuper

# --- ключи внешних сервисов (нужны с этапа 1) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
FISH_API_KEY=
FISH_MODEL=s1
# Обязательно: без reference_id Fish синтезирует новый случайный голос каждый раз
FISH_VOICE_ID=23632847285a487d8e0c6ae5bc593c71
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=
# Тариф оценки произношения. Аккаунту открывают конкретный набор, чужой
# coreType сервис отвергает с errId 41030. На нашем ключе доступен sent.eval.cn
# (балл тона на иероглиф); sent.eval.promax.cn добавил бы услышанный тон.
SPEECHSUPER_CORE_TYPE=sent.eval.cn
LAVATOP_API_KEY=
# Секрет вебхука. Его придумываем МЫ (до 80 символов) и вписываем в кабинете
# lava.top при добавлении вебхука, тип аутентификации «API key вашего сервиса»:
# lava пришлёт его заголовком X-Api-Key. Пусто — сверяется ключ API, тогда в
# кабинете надо вписать именно его. Идентификатор оффера (цены) живёт не здесь,
# а в базе — колонка plans.offer_id, чтобы тариф менялся из админки.
LAVATOP_WEBHOOK_SECRET=

# --- админы, через запятую ---
# Telegram-id тех, кому открыт /admin. Этот список несменяемый: выданные
# командой /admin_add лежат в базе и оттуда же убираются, а прописанного здесь
# из бота не отобрать — иначе один неверный /admin_del оставил бы бота без
# единого админа. Пусто — админки нет ни у кого.
ADMIN_IDS=

# --- только для боевого compose ---
POSTGRES_PASSWORD=

# --- запасной провайдер озвучки (TTS_PROVIDER=openai) ---
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Запасная озвучка на случай сбоя основной (пусто — фолбэка нет)
TTS_FALLBACK_PROVIDER=openai
